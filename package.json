{
  "name": "lion-gym",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node scripts/start-local.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "auth:bootstrap-owner": "node --env-file-if-exists=.env dist/api/auth/bootstrap-owner.js",
    "dev:web": "vite web --config web/vite.config.ts",
    "dev:api": "npm run build:api && npm run start:api",
    "start:api": "node --env-file-if-exists=.env dist/api/main.js",
    "build:api": "tsc -p api/tsconfig.json",
    "build:web": "vite build web --config web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "check": "tsc -p api/tsconfig.json --noEmit && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@nestjs/throttler": "6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "embedded-postgres": "17.12.0-beta.19",
    "prisma": "7.10.1",
    "typescript": "~6.0.0",
    "vite": "8.3.8"
  }
}
